{
  "$description": "Neon Sumi design tokens: neon tubes on an ink-wash scroll. The one source for every port. Edit here, then run python3 tools/build_themes.py.",
  "$extensions": {
    "neon-sumi": {
      "theme": "Neon Sumi",
      "version": "0.1.0",
      "author": "Danneftw1",
      "repository": "https://github.com/Danneftw1/neon-sumi",
      "rules": [
        "Neon is for what is live or interactive. Everything static is ink and paper.",
        "In live status, warm means trouble: amber at 70 %, red at 85 %. Nothing warm sits there at rest.",
        "Glow goes on neon, never on prose.",
        "Dark only. A light surface borrows the dark palette."
      ]
    }
  },

  "color": {
    "$type": "color",
    "deep":      { "$value": "#0b090a", "$description": "Sunken: sidebars, title bars, inputs, code blocks." },
    "sumi":      { "$value": "#0f0c0d", "$description": "The scroll: editor, page and terminal ground." },
    "sumi-hi":   { "$value": "#131011", "$description": "Cards and title bars on the page; current line in editors." },
    "raised":    { "$value": "#171314", "$description": "Cards, popups, menus, toolbars." },
    "raised-hi": { "$value": "#1e191a", "$description": "Hover on raised; the ink-wash centre behind the mark." },
    "overlay":   { "$value": "#251e20", "$description": "Selected row in a menu, pressed control." },
    "line":      { "$value": "#2c2426", "$description": "Borders and dividers." },
    "line-hi":   { "$value": "#403736", "$description": "Strong borders, scrollbar thumbs, whitespace glyphs." },
    "ink":       { "$value": "#544a46", "$description": "Separators and decoration. 2.3:1, never text someone has to read." },
    "ink-hi":    { "$value": "#73685f", "$description": "Punctuation, line numbers, placeholders." },
    "stone":     { "$value": "#928678", "$description": "Secondary text." },
    "soft":      { "$value": "#cbbfa9", "$description": "Code and soft text." },
    "paper":     { "$value": "#e8dcc6", "$description": "Body text." },
    "bright":    { "$value": "#f7efe2", "$description": "Titles, bold, the selected thing." },

    "magenta":   { "$value": "#ff2ec4", "$description": "The brand tube. Focus, cursor, primary action, keywords." },
    "violet":    { "$value": "#c46eff", "$description": "Second accent. Merged, operators, decorators." },
    "blue":      { "$value": "#409cff", "$description": "Functions, GitHub, modified." },
    "cyan":      { "$value": "#00eaff", "$description": "External links, properties, info." },
    "teal":      { "$value": "#00ffcc", "$description": "Types, tags, the machine." },
    "mint":      { "$value": "#40ffaa", "$description": "Strings, success, added." },
    "amber":     { "$value": "#ffbe28", "$description": "Numbers in code; warning in live status." },
    "gold":      { "$value": "#ffd76e", "$description": "Brand gold: regex, escapes, bright yellow. Never a state." },
    "red":       { "$value": "#ff3864", "$description": "Errors, deleted, critical." },

    "red-hi":    { "$value": "#ff6a8a", "$description": "Bright red (ANSI 9), error hover." },
    "mint-hi":   { "$value": "#7dffc4", "$description": "Bright green (ANSI 10)." },
    "blue-hi":   { "$value": "#7ab8ff", "$description": "Bright blue (ANSI 12)." },
    "core":      { "$value": "#ffc2ee", "$description": "The white-hot core of a lit tube (the mark)." },
    "selection": { "$value": "#3a1830", "$description": "Selected text: magenta steeped in sumi." },
    "black":     { "$value": "#1a1516", "$description": "ANSI black, one step above the ground so black-on-ground still shows." }
  },

  "role": {
    "$type": "color",
    "surface": {
      "sunken":       { "$value": "{color.deep}" },
      "ground":       { "$value": "{color.sumi}" },
      "hover":        { "$value": "{color.sumi-hi}" },
      "raised":       { "$value": "{color.raised}" },
      "raised-hover": { "$value": "{color.raised-hi}" },
      "overlay":      { "$value": "{color.overlay}" },
      "selection":    { "$value": "{color.selection}" }
    },
    "border": {
      "subtle": { "$value": "{color.line}" },
      "strong": { "$value": "{color.line-hi}" },
      "focus":  { "$value": "{color.magenta}" }
    },
    "text": {
      "decor":     { "$value": "{color.ink}" },
      "faint":     { "$value": "{color.ink-hi}" },
      "muted":     { "$value": "{color.stone}" },
      "soft":      { "$value": "{color.soft}" },
      "normal":    { "$value": "{color.paper}" },
      "strong":    { "$value": "{color.bright}" },
      "on-accent": { "$value": "{color.sumi}" }
    },
    "accent": {
      "primary":   { "$value": "{color.magenta}" },
      "secondary": { "$value": "{color.violet}" }
    },
    "link": {
      "internal":   { "$value": "{color.magenta}" },
      "external":   { "$value": "{color.cyan}" },
      "unresolved": { "$value": "{color.violet}" }
    },
    "status": {
      "ok":   { "$value": "{color.mint}" },
      "warn": { "$value": "{color.amber}" },
      "crit": { "$value": "{color.red}" },
      "info": { "$value": "{color.cyan}" },
      "done": { "$value": "{color.violet}" }
    },
    "heading": {
      "h1": { "$value": "{color.magenta}" },
      "h2": { "$value": "{color.violet}" },
      "h3": { "$value": "{color.bright}" },
      "h4": { "$value": "{color.paper}" },
      "h5": { "$value": "{color.soft}" },
      "h6": { "$value": "{color.soft}" }
    },
    "syntax": {
      "text":        { "$value": "{color.soft}" },
      "comment":     { "$value": "{color.stone}" },
      "punctuation": { "$value": "{color.ink-hi}" },
      "keyword":     { "$value": "{color.magenta}" },
      "operator":    { "$value": "{color.violet}" },
      "decorator":   { "$value": "{color.violet}" },
      "self":        { "$value": "{color.violet}" },
      "function":    { "$value": "{color.blue}" },
      "type":        { "$value": "{color.teal}" },
      "tag":         { "$value": "{color.teal}" },
      "property":    { "$value": "{color.cyan}" },
      "string":      { "$value": "{color.mint}" },
      "regexp":      { "$value": "{color.gold}" },
      "number":      { "$value": "{color.amber}" },
      "constant":    { "$value": "{color.amber}" },
      "invalid":     { "$value": "{color.red}" }
    },
    "git": {
      "added":     { "$value": "{color.mint}" },
      "modified":  { "$value": "{color.blue}" },
      "deleted":   { "$value": "{color.red}" },
      "renamed":   { "$value": "{color.violet}" },
      "untracked": { "$value": "{color.teal}" },
      "ignored":   { "$value": "{color.ink}" },
      "conflict":  { "$value": "{color.amber}" }
    }
  },

  "ansi": {
    "$type": "color",
    "0":  { "$value": "{color.black}" },
    "1":  { "$value": "{color.red}" },
    "2":  { "$value": "{color.mint}" },
    "3":  { "$value": "{color.amber}" },
    "4":  { "$value": "{color.blue}" },
    "5":  { "$value": "{color.magenta}" },
    "6":  { "$value": "{color.cyan}" },
    "7":  { "$value": "{color.paper}" },
    "8":  { "$value": "{color.ink}" },
    "9":  { "$value": "{color.red-hi}" },
    "10": { "$value": "{color.mint-hi}" },
    "11": { "$value": "{color.gold}" },
    "12": { "$value": "{color.blue-hi}" },
    "13": { "$value": "{color.violet}" },
    "14": { "$value": "{color.teal}" },
    "15": { "$value": "{color.bright}" }
  },

  "statusline": {
    "$type": "color",
    "gutter": {
      "claude":  { "$value": "{color.magenta}" },
      "github":  { "$value": "{color.blue}" },
      "machine": { "$value": "{color.teal}" }
    },
    "meter": {
      "$description": "Tube ramps, dim end to hot end. Cool at rest; warm only when in trouble.",
      "ctx-from":  { "$value": "#783cff" },
      "ctx-to":    { "$value": "#ec48ff" },
      "5h-from":   { "$value": "#00aa96" },
      "5h-to":     { "$value": "{color.cyan}" },
      "wk-from":   { "$value": "#3060ff", "$description": "Blue, so the weekly bar never reads as the warm warn family." },
      "wk-to":     { "$value": "{color.blue-hi}" },
      "warn-from": { "$value": "#ff6496" },
      "warn-to":   { "$value": "{color.amber}" },
      "crit-from": { "$value": "{color.red}" },
      "crit-to":   { "$value": "#ff7800" },
      "track":     { "$value": "#3e3438", "$description": "Unlit glass, both editions." }
    },
    "percent": {
      "rest": { "$value": "{color.cyan}" },
      "warn": { "$value": "{color.amber}" },
      "crit": { "$value": "{color.red}" }
    },
    "model": {
      "$description": "The model and effort chips on the first row (MODEL_TIERS and EFFORT_LEVELS in statusline.py).",
      "fable":  { "$value": "{color.violet}" },
      "opus":   { "$value": "{color.magenta}" },
      "sonnet": { "$value": "{color.blue}" },
      "haiku":  { "$value": "{color.mint}" }
    },
    "effort": {
      "low":    { "$value": "{color.stone}" },
      "medium": { "$value": "{color.teal}" },
      "high":   { "$value": "{color.cyan}" },
      "xhigh":  { "$value": "{color.violet}" },
      "max":    { "$value": "{color.magenta}" }
    }
  },

  "threshold": {
    "$type": "number",
    "warn": { "$value": 70, "$description": "Percent. Bars, subagent line and cockpit all use the same two numbers." },
    "crit": { "$value": 85 }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Zen Kaku Gothic New", "Hiragino Sans", "system-ui", "sans-serif"], "$description": "Prose, headings, interface." },
      "mono": { "$value": ["Maple Mono NF", "Maple Mono", "JetBrains Mono", "ui-monospace", "Menlo", "monospace"], "$description": "Code, terminal, labels, buttons, the status line. NF carries the Nerd Font icons." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium":  { "$value": 500, "$description": "Emphasis inside muted prose." },
      "bold":    { "$value": 700, "$description": "Headings, the identity chip." }
    },
    "size": {
      "$type": "dimension",
      "display":  { "$value": "clamp(38px, 7vw, 66px)", "$description": "One per page: the product name." },
      "title":    { "$value": "clamp(22px, 3vw, 28px)", "$description": "Section headings." },
      "body":     { "$value": "16px" },
      "card":     { "$value": "15px", "$description": "Card prose." },
      "small":    { "$value": "14px", "$description": "Notes under a block." },
      "code":     { "$value": "13.5px", "$description": "Mono: code blocks." },
      "button":   { "$value": "13px", "$description": "Mono: buttons." },
      "label":    { "$value": "12px", "$description": "Mono: eyebrows, bars, pills, footers. Eyebrows uppercase, 0.08em." },
      "micro":    { "$value": "11px", "$description": "Mono: card keys, uppercase, 0.08em." },
      "editor":   { "$value": "14px", "$description": "Editor ports." },
      "terminal": { "$value": "16px", "$description": "Ghostty, with cell height +12 %." }
    },
    "leading": {
      "$type": "number",
      "display": { "$value": 1.02 },
      "title":   { "$value": 1.2 },
      "prose":   { "$value": 1.6 }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "The values the page uses, as they are.",
    "6":  { "$value": "6px",  "$description": "Dots, gaps inside a card." },
    "8":  { "$value": "8px",  "$description": "Between pills." },
    "10": { "$value": "10px", "$description": "Between buttons; header rows." },
    "12": { "$value": "12px", "$description": "Inside a title bar." },
    "14": { "$value": "14px", "$description": "Grid gaps; button and code padding." },
    "18": { "$value": "18px", "$description": "Card padding (16 × 18)." },
    "20": { "$value": "20px", "$description": "Page gutter." },
    "40": { "$value": "40px", "$description": "Between sections." },
    "64": { "$value": "64px", "$description": "Page foot." }
  },

  "radius": {
    "$type": "dimension",
    "chip":    { "$value": "6px",   "$description": "Copy button, small controls." },
    "control": { "$value": "8px",   "$description": "Buttons, toggles, code blocks." },
    "card":    { "$value": "10px",  "$description": "Cards." },
    "panel":   { "$value": "12px",  "$description": "Window frames: the stage, previews." },
    "pill":    { "$value": "999px", "$description": "Pills and tags." },
    "mark":    { "$value": "22%",   "$description": "The app-icon squircle: 112 of 512." }
  },

  "focus": {
    "$type": "color",
    "ring":      { "$value": "{color.magenta}", "$description": "2px solid, 2px offset." },
    "on-accent": { "$value": "{color.teal}", "$description": "The ring on a magenta fill." }
  },

  "glow": {
    "$type": "shadow",
    "$description": "The only elevation. Text glow for neon text; tube glow for lit controls.",
    "text":  { "$value": "0 0 7px rgba({rgb}, 0.42), 0 0 2px rgba({rgb}, 0.25)", "$description": "Neon text: magenta, violet, blue, red." },
    "text-bright": { "$value": "0 0 7px rgba({rgb}, 0.36), 0 0 2px rgba({rgb}, 0.22)", "$description": "Neon text in the bright hues: cyan, teal, mint, amber, gold." },
    "button": { "$value": "0 0 18px rgba({rgb}, 0.45)", "$description": "A lit button at rest." },
    "tube":  { "$value": "0 0 14px rgba({rgb}, 0.6)", "$description": "A pressed toggle." },
    "lit":   { "$value": "0 0 26px rgba({rgb}, 0.7)", "$description": "A lit button under the pointer." },
    "stage": { "$value": "0 0 0 1px rgba({rgb}, 0.14), 0 40px 90px -40px rgba({rgb}, 0.45)", "$description": "The window frame around a live demo." }
  },

  "motion": {
    "$description": "Light moves, layout does not. Glow may breathe; nothing slides. Under reduced motion, everything holds still.",
    "quick": { "$type": "duration", "$value": "120ms" },
    "flow":  { "$type": "duration", "$value": "420ms" },
    "ease":  { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] }
  }
}
