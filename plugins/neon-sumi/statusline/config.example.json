{
  "_about": "Copy to config.json next to statusline.py. Every key is optional.",
  "edition": "auto",
  "layout": "full",
  "guide_url": "",
  "cost_warn": 3,
  "cost_crit": 8,
  "vaults": [
    {"path": "~/notes", "name": "notes"}
  ],
  "repos": {
    "your-name/your-repo": [
      {"label": "board", "kind": "board", "url": "https://github.com/users/your-name/projects/1"},
      {"label": "Vercel", "kind": "vercel", "url": "https://vercel.com/your-team/your-repo"},
      {"label": "v0 chat", "kind": "v0", "url": "https://v0.app/chat"}
    ]
  },
  "boards": {
    "your-name": [
      {"label": "Roadmap", "number": 1, "url": "https://github.com/users/your-name/projects/1"}
    ]
  },
  "services": [
    {"label": "GitHub", "kind": "github", "url": "https://github.com"},
    {"label": "Vercel", "kind": "vercel", "url": "https://vercel.com/dashboard"},
    {"label": "v0", "kind": "v0", "url": "https://v0.app/chat"}
  ],
  "resources": [
    {"label": "status line docs", "url": "https://code.claude.com/docs/en/statusline"},
    {"label": "OTel monitoring", "url": "https://code.claude.com/docs/en/monitoring-usage"},
    {"label": "CC changelog", "url": "https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md"}
  ],
  "keys": [
    {"key": "esc esc", "what": "rewind"},
    {"key": "ctrl+s", "what": "stash prompt"},
    {"key": "ctrl+b", "what": "background task"},
    {"key": "ctrl+x enter", "what": "queue msg"},
    {"key": "ctrl+x ctrl+s", "what": "send queued now"},
    {"key": "ctrl+r", "what": "history \u00b7 ctrl+s scope"},
    {"key": "ctrl+o", "what": "transcript \u00b7 [ v { }"},
    {"key": "ctrl+_", "what": "undo edit"},
    {"key": "ctrl+w ctrl+y alt+y", "what": "kill \u00b7 yank \u00b7 ring"},
    {"key": "alt+p", "what": "model"},
    {"key": "alt+t", "what": "thinking"},
    {"key": "alt+o", "what": "fast"},
    {"key": "alt+v", "what": "image (WSL)"},
    {"key": "ctrl+z", "what": "suspend"},
    {"key": "?", "what": "all keys"}
  ]
}
